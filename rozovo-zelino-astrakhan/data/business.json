      {
        "reviewId": "7-ckDF_79yApwTzCK2U497kW2ThagCO",
        "businessId": "232288470525",
        "author": {
          "name": "Наталья",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/59871/0f-9/{size}",
