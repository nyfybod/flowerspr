      {
        "reviewId": "yHjlnqJeHRMSxVJNjegKZKvJT8GKYf",
        "businessId": "173964306387",
        "author": {
          "name": "Дарья",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/40841/enc-b1a079bc68b070ca9cb514d7462336a30b35c0b90bfee349e77b2a6f1933d85a/{size}",
