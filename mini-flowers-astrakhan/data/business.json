        "businessId": "216915517716",
        "author": {
          "name": "Ксения Савельева",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/47747/Oget9LScevCh8zNKw7ERCLDd0w-1/{size}",
          "professionLevel": "Level 3 Local Expert",
