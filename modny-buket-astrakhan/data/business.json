      {
        "reviewId": "uQ0KRrsRzqQTwmVSnH4HhrRWKqV784KKh",
        "businessId": "1106242378",
        "author": {
          "name": "Нина Шеина",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/51381/8mcNF8bZQkCZeN9wZ3GBfvYVN8-1/{size}",
          "professionLevel": "Level 6 Local Expert",
