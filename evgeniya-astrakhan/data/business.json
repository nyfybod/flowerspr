      {
        "reviewId": "meKt9q_GLGUsFQ0TcdjliJHt0kc3557RM",
        "businessId": "31464616424",
        "author": {
          "name": "Риат Ахунов",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/43978/0y-9/{size}",
          "professionLevel": "Level 9 Local Expert",
          "rtb": "Level 9 Local Expert",
          "rtbType": "PROFESSION",
          "publicId": "k7ea2gnb924udqkcutjngfwmwr",
          "achievements": [],
          "professions": [],
          "isSubscribed": false
        },
        "text": "Девушка консультант просто молодец, в первый день пошли к друзьям в гости предложила нам очень красивый букет, жене друга очень понравился. А на первое сентября такой букет классный был в виде сумочки, самый красивый в классе. Цветы- видно очень свежие, несмотря что у нас не было карты постоянного клиента, продавец сделала нам приятную скидку. Буду в Астрахани, обязательно заскочу ещё за цветами для друзей)",
        "textLanguage": "unknown",
        "textTranslations": {},
        "rating": 5,
        "updatedTime": "2020-09-09T21:56:53.085Z",
