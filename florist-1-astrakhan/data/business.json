        "reviewId": "22Dv6Oh1_zcXThkbgpnzjqL8YSl0dZ",
        "businessId": "78251873351",
        "author": {
          "name": "Юлия Бузарова",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/27503/0r-4/{size}",
