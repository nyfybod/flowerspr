        "businessId": "171059725914",
        "author": {
          "name": "Инкогнито 9559",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/57243/0s-6/{size}",
          "professionLevel": "Level 3 Local Expert",
