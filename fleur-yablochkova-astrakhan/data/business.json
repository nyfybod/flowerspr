      {
        "reviewId": "jiXEp3m7KMSNmTrPosIlE1JBJT86GY-",
        "businessId": "171059725914",
        "author": {
          "name": "Екатерина",
          "avatarUrl": "https://avatars.mds.yandex.net/get-yapic/51381/0a-5/{size}",
